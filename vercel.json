{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run demo:build",
  "outputDirectory": "demo/dist",
  "rewrites": [
    {
      "source": "/projects/inkblot/demo",
      "destination": "/index.html"
    },
    {
      "source": "/projects/inkblot/demo/:path*",
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "inkblot-demo.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
